{
  "name": "launchcheck",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test tests/flow.spec.ts tests/repo.spec.ts tests/security.spec.ts",
    "shots": "playwright test tests/shots.spec.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8",
    "@neondatabase/serverless": "latest",
    "cheerio": "latest",
    "ipaddr.js": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "latest",
    "stripe": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
